<Project Sdk="Microsoft.NET.Sdk">

  <!-- iPhone + iPad build. Shares the game core in ../src (everything except src/Desktop)
       and swaps in an iOS host: GLKView + OpenGL ES 3.0, AVAudioEngine, touch input. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Dungeon</RootNamespace>
    <AssemblyName>TorchlightDepths</AssemblyName>

    <ApplicationId>com.lesbird.torchlightdepths</ApplicationId>
    <ApplicationTitle>Torchlight Depths</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Assets.xcassets/AppIcon.appiconset, rendered by the game itself (desktop build, icon mode; see README) -->
    <AppIcon>AppIcon</AppIcon>

    <!-- OpenGL ES / GLKit are deprecated by Apple but still shipped; silence the obsolete warnings. -->
    <NoWarn>$(NoWarn);CA1422;CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/**/*.cs" Exclude="../src/Desktop/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Store privacy manifest: must sit at the root of the .app bundle. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only OpenTK's math library: its windowing (GLFW) and OpenAL don't exist on iOS, and its
         GL bindings need a JIT — GLES.cs provides AOT-safe GL entry points in their place. -->
    <PackageReference Include="OpenTK.Mathematics" Version="4.8.2" />
  </ItemGroup>

</Project>
